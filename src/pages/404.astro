---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { useTranslations } from '../i18n/ui';

const t = useTranslations('hu');
const tEn = useTranslations('en');
---

<Base lang="hu" title={`404 — ${t('404.title')}`} description={t('404.body')} noindex>
  <main
    id="tartalom"
    class="grid-lines flex min-h-screen flex-col items-start justify-center gap-5 px-6 py-16 lg:px-12"
  >
    <p class="font-mono text-[0.78rem] font-medium tracking-[0.2em] text-accent uppercase">404</p>

    <h1 class="text-[clamp(1.8rem,4vw,2.6rem)] leading-tight font-medium tracking-[-0.03em]">
      {t('404.title')}
    </h1>

    <p class="max-w-[52ch] text-[0.88rem] leading-relaxed font-light text-mu">{t('404.body')}</p>
    <p class="max-w-[52ch] text-[0.82rem] leading-relaxed font-light text-fa" lang="en">{tEn('404.body')}</p>

    <div class="mt-2 flex flex-wrap gap-2.5">
      <a
        href="/"
        class="bg-accent px-4 py-2 text-[0.75rem] font-semibold text-on-accent transition-opacity hover:opacity-90"
      >
        {t('404.back')}
      </a>
      <a
        href="/en/"
        class="border border-line2 px-4 py-2 text-[0.75rem] font-medium transition-colors hover:border-accent hover:text-accent"
        hreflang="en"
        lang="en"
      >
        {tEn('404.back')}
      </a>
    </div>

    <p class="mt-6 text-[0.75rem] text-fa">
      <a href={`mailto:${site.email}`} class="border-b border-line2 transition-colors hover:text-accent">
        {site.email}
      </a>
    </p>
  </main>
</Base>

---
import { RECAPTCHA_SITE_KEY } from 'astro:env/server';
import { site, type Lang } from '../data/site';
import { useTranslations } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

// Ha nincs kulcs beállítva, a captcha kimarad, az űrlap enélkül is működik.
const recaptchaKey = RECAPTCHA_SITE_KEY;
---


<div class="flex flex-col gap-5">
  <div>
    <p class="text-lg font-medium tracking-[-0.025em]">{t('contact.heading')}</p>
    <a
      href={`mailto:${site.email}`}
      class="mt-3 inline-block border-b border-accent text-[0.95rem] text-accent transition-colors hover:text-tx"
    >
      {site.email}
    </a>
  </div>

  <form
    id="contact-form"
    method="post"
    action="/mail.php"
    data-recaptcha-key={recaptchaKey}
    class="flex flex-col gap-3 border border-line bg-surface/85 p-4"
  >
    <input type="hidden" name="lang" value={lang} />
    <!-- Spamcsapda: valódi látogató nem tölti ki -->
    <p class="hidden" aria-hidden="true">
      <label>Ne töltsd ki<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
    </p>

    <div class="grid gap-3 sm:grid-cols-2">
      <label class="flex flex-col gap-1.5">
        <span class="label">{t('contact.form.name')}</span>
        <input
          type="text" name="name" required autocomplete="name"
          class="border border-line2 bg-ground px-3 py-2 text-[0.82rem] text-tx placeholder:text-fa focus:border-accent focus:outline-none"
        />
      </label>
      <label class="flex flex-col gap-1.5">
        <span class="label">{t('contact.form.email')}</span>
        <input
          type="email" name="email" required autocomplete="email"
          class="border border-line2 bg-ground px-3 py-2 text-[0.82rem] text-tx placeholder:text-fa focus:border-accent focus:outline-none"
        />
      </label>
    </div>

    <label class="flex flex-col gap-1.5">
      <span class="label">{t('contact.form.message')}</span>
      <textarea
        name="message" required rows="4"
        class="resize-y border border-line2 bg-ground px-3 py-2 text-[0.82rem] text-tx placeholder:text-fa focus:border-accent focus:outline-none"
      ></textarea>
    </label>

    <div class="flex flex-wrap items-center gap-3">
      <button
        type="submit"
        class="bg-accent px-4 py-2 text-[0.75rem] font-semibold text-on-accent transition-opacity hover:opacity-90 disabled:opacity-60"
        data-send={t('contact.form.send')}
        data-sending={t('contact.form.sending')}
      >
        {t('contact.form.send')}
      </button>
      <p
        id="contact-status"
        role="status"
        class="text-[0.75rem] text-mu empty:hidden"
        data-ok={t('contact.form.ok')}
        data-error={t('contact.form.error')}
      ></p>
    </div>

    {recaptchaKey && (
      <>
        <noscript>
          <p class="text-[0.72rem] text-mu">{t('contact.form.nojs')}</p>
        </noscript>
        <p class="text-[0.68rem] leading-relaxed text-fa">
          {t('recaptcha.notice')}{' '}
          <a
            href="https://policies.google.com/privacy"
            target="_blank"
            rel="noopener"
            class="border-b border-line2 transition-colors hover:text-mu"
          >{t('recaptcha.privacy')}</a>{' · '}
          <a
            href="https://policies.google.com/terms"
            target="_blank"
            rel="noopener"
            class="border-b border-line2 transition-colors hover:text-mu"
          >{t('recaptcha.terms')}</a>
        </p>
      </>
    )}
  </form>
</div>

<script>
  // Küldés oldalfrissítés nélkül. JS nélkül is működik: a form simán elküldi magát.
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('contact-status');
  const button = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null;

  // A reCAPTCHA ~400 KB-ot tölt le, ezért csak akkor kérjük le, amikor a látogató
  // tényleg az űrlappal kezd foglalkozni. Így az oldal betöltését nem lassítja.
  let recaptchaScript: Promise<void> | null = null;

  const loadRecaptcha = (key: string) => {
    recaptchaScript ??= new Promise<void>((resolve, reject) => {
      const script = document.createElement('script');
      script.src = `https://www.google.com/recaptcha/api.js?render=${key}`;
      script.async = true;
      script.onload = () => resolve();
      script.onerror = () => reject(new Error('recaptcha'));
      document.head.appendChild(script);
    });
    return recaptchaScript;
  };

  const key = form?.dataset.recaptchaKey;
  if (form && key) {
    const start = () => void loadRecaptcha(key).catch(() => {});
    form.addEventListener('focusin', start, { once: true });
    form.addEventListener('pointerdown', start, { once: true });
  }

  form?.addEventListener('submit', async (event) => {
    if (!status || !button) return;
    event.preventDefault();

    button.disabled = true;
    button.textContent = button.dataset.sending!;
    status.textContent = '';
    status.classList.remove('text-accent');

    try {
      const data = new FormData(form);

      // reCAPTCHA v3: a token a háttérben készül, a látogatónak nincs teendője
      if (key) {
        await loadRecaptcha(key);
        const grecaptcha = (window as any).grecaptcha;
        await new Promise<void>((resolve) => grecaptcha.ready(resolve));
        data.append('recaptcha_token', await grecaptcha.execute(key, { action: 'contact' }));
      }

      const response = await fetch(form.action, {
        method: 'POST',
        body: data,
        headers: { Accept: 'application/json' },
      });
      if (!response.ok) throw new Error(String(response.status));
      status.textContent = status.dataset.ok!;
      status.classList.add('text-accent');
      form.reset();
    } catch {
      status.textContent = status.dataset.error!;
    } finally {
      button.disabled = false;
      button.textContent = button.dataset.send!;
    }
  });
</script>

---
import type { Lang } from '../data/site';
import { useTranslations } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<dialog
  id="lightbox"
  aria-label={t('gallery.enlarge')}
  class="m-0 h-dvh max-h-none w-screen max-w-none bg-transparent p-0 text-tx
         backdrop:bg-ground/90 backdrop:backdrop-blur-sm open:flex"
>
  <div class="relative flex size-full flex-col items-center justify-center gap-3 px-4 py-14 sm:px-16" data-lb-stage>
    <img
      data-lb-img
      alt=""
      class="lb-img max-h-full min-h-0 max-w-full border border-line2 object-contain shadow-[0_24px_80px_-20px_rgba(0,0,0,.9)]"
    />

    <p class="flex items-baseline gap-3 text-[0.8rem]">
      <span data-lb-title class="font-medium"></span>
      <span data-lb-count class="font-mono text-[0.7rem] text-fa tabular-nums"></span>
    </p>

    <button
      type="button"
      data-lb-close
      aria-label={t('gallery.close')}
      class="absolute top-3 right-3 grid size-9 place-items-center border border-line2 bg-ground/85
             font-mono text-base text-tx transition-colors hover:border-accent hover:text-accent"
    >
      ✕
    </button>

    <button
      type="button"
      data-lb-prev
      aria-label={t('gallery.prev')}
      class="absolute top-1/2 left-3 grid size-10 -translate-y-1/2 place-items-center border border-line2
             bg-ground/85 font-mono text-base text-tx transition-colors hover:border-accent hover:text-accent"
    >
      ←
    </button>
    <button
      type="button"
      data-lb-next
      aria-label={t('gallery.next')}
      class="absolute top-1/2 right-3 grid size-10 -translate-y-1/2 place-items-center border border-line2
             bg-ground/85 font-mono text-base text-tx transition-colors hover:border-accent hover:text-accent"
    >
      →
    </button>
  </div>
</dialog>

<style>
  /* Megnyitáskor és képváltáskor finom beúszás; a globális reduced-motion szabály kikapcsolja */
  dialog[open] .lb-img {
    animation: lb-in 0.22s ease-out;
  }
  dialog[open]::backdrop {
    animation: lb-fade 0.2s ease-out;
  }
  @keyframes lb-in {
    from { opacity: 0; transform: scale(0.97); }
    to { opacity: 1; transform: none; }
  }
  @keyframes lb-fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }
</style>

<script>
  const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;

  if (dialog) {
    const img = dialog.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const title = dialog.querySelector<HTMLElement>('[data-lb-title]')!;
    const counter = dialog.querySelector<HTMLElement>('[data-lb-count]')!;
    const prev = dialog.querySelector<HTMLButtonElement>('[data-lb-prev]')!;
    const next = dialog.querySelector<HTMLButtonElement>('[data-lb-next]')!;

    let images: { src: string; alt: string }[] = [];
    let index = 0;
    let source: HTMLElement | null = null; // a lapozó, ahonnan megnyitottuk

    const render = () => {
      const current = images[index];
      img.src = current.src;
      img.alt = current.alt;
      // az animáció minden képváltáskor induljon újra
      img.style.animation = 'none';
      void img.offsetWidth;
      img.style.animation = '';
      counter.textContent = images.length > 1 ? `${index + 1} / ${images.length}` : '';
      prev.hidden = next.hidden = images.length < 2;
    };

    const step = (delta: number) => {
      if (images.length < 2) return;
      index = (index + delta + images.length) % images.length;
      render();
    };

    // Megnyitás bármelyik lapozó képére kattintva (eseménydelegálás)
    document.addEventListener('click', (event) => {
      const trigger = (event.target as HTMLElement).closest<HTMLElement>('[data-lb-open]');
      if (!trigger) return;
      source = trigger.closest<HTMLElement>('[data-carousel]');
      if (!source) return;

      images = [...source.querySelectorAll<HTMLImageElement>('[data-lb-open] img')].map((el) => ({
        src: el.currentSrc || el.src,
        alt: el.alt,
      }));
      index = Number(trigger.dataset.index ?? 0);
      title.textContent = source.getAttribute('aria-label') ?? '';
      render();

      document.documentElement.style.overflow = 'hidden';
      dialog.showModal();
    });

    prev.addEventListener('click', () => step(-1));
    next.addEventListener('click', () => step(1));
    dialog.querySelector('[data-lb-close]')!.addEventListener('click', () => dialog.close());

    // Kattintás a kép mellé (a sötét háttérre) bezár
    dialog.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      if (target === dialog || target.hasAttribute('data-lb-stage')) dialog.close();
    });

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        event.preventDefault();
        dialog.close();
      } else if (event.key === 'ArrowLeft') {
        event.preventDefault();
        step(-1);
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        step(1);
      }
    });

    // Ujjal húzás mobilon
    let touchX: number | null = null;
    dialog.addEventListener('touchstart', (event) => {
      touchX = event.touches[0].clientX;
    }, { passive: true });
    dialog.addEventListener('touchend', (event) => {
      if (touchX === null) return;
      const dx = event.changedTouches[0].clientX - touchX;
      if (Math.abs(dx) > 50) step(dx < 0 ? 1 : -1);
      touchX = null;
    });

    // Bezáráskor a kártya lapozója arra a képre álljon, amit utoljára néztél
    dialog.addEventListener('close', () => {
      document.documentElement.style.overflow = '';
      const track = source?.querySelector<HTMLElement>('[data-track]');
      if (track) track.scrollTo({ left: index * track.clientWidth, behavior: 'auto' });
    });
  }
</script>

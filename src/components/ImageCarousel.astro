---
import { Image } from 'astro:assets';
import type { Lang } from '../data/site';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  images: ImageMetadata[];
  /** A hajtás fölötti első kártya képe töltődjön azonnal, a többi csak ha kell. */
  priority?: boolean;
}

const { lang, title, images, priority = false } = Astro.props;
const t = useTranslations(lang);
const count = images.length;

// A kártya nagyjából a tartalomsáv fele, mobilon a teljes szélesség
const sizes = '(min-width: 1024px) 34vw, (min-width: 768px) 46vw, 92vw';
---

<div
  class="group relative aspect-video overflow-hidden border-b border-line bg-ground"
  data-carousel
  role="region"
  aria-roledescription="carousel"
  aria-label={title}
>
  <div
    class="flex h-full snap-x snap-mandatory overflow-x-auto overscroll-x-contain
           [scrollbar-width:none] [&::-webkit-scrollbar]:hidden focus-visible:outline-offset-[-2px]"
    data-track
    tabindex={count > 1 ? 0 : undefined}
  >
    {images.map((src, i) => (
      <figure
        class="relative m-0 h-full w-full shrink-0 snap-center overflow-hidden"
        role="group"
        aria-roledescription="slide"
        aria-label={`${i + 1} / ${count}`}
      >
        <!-- Elmosott háttér ugyanabból a képből, hogy az álló képek mellett se maradjon üres sáv.
             Mivel homályos, elég belőle egy pici változat. -->
        <Image
          src={src}
          alt=""
          aria-hidden="true"
          widths={[48]}
          sizes="48px"
          loading="lazy"
          decoding="async"
          class="absolute inset-0 size-full scale-110 object-cover opacity-25 blur-xl"
        />
        <button
          type="button"
          data-lb-open
          data-index={i}
          data-full={src.src}
          aria-label={`${t('gallery.enlarge')}: ${title}${count > 1 ? ` (${i + 1}/${count})` : ''}`}
          class="relative block size-full cursor-zoom-in focus-visible:outline-offset-[-2px]"
        >
          <Image
            src={src}
            alt={
              count > 1
                ? `${title} — ${t('gallery.screenshot')} ${i + 1}/${count}`
                : `${title} — ${t('gallery.screenshot')}`
            }
            widths={[360, 640, 960]}
            sizes={sizes}
            loading={priority && i === 0 ? 'eager' : 'lazy'}
            decoding="async"
            class="size-full object-contain"
          />
        </button>
      </figure>
    ))}
  </div>

  {count > 1 && (
    <>
      {[
        { dir: 'prev', label: t('gallery.prev'), side: 'left-2', arrow: '←' },
        { dir: 'next', label: t('gallery.next'), side: 'right-2', arrow: '→' },
      ].map(({ dir, label, side, arrow }) => (
        <button
          type="button"
          data-dir={dir}
          aria-label={label}
          class:list={[
            'absolute top-1/2 grid size-8 -translate-y-1/2 place-items-center border border-line2 bg-ground/85',
            'font-mono text-sm text-tx backdrop-blur-sm transition-[opacity,color,border-color]',
            'opacity-0 group-hover:opacity-100 focus-visible:opacity-100 [@media(hover:none)]:opacity-100',
            'hover:border-accent hover:text-accent',
            side,
          ]}
        >
          {arrow}
        </button>
      ))}

      <div class="absolute inset-x-0 bottom-1.5 flex justify-center">
        <div class="flex items-center bg-ground/70 px-1 backdrop-blur-sm">
          {images.map((_, i) => (
            <button
              type="button"
              data-dot={i}
              aria-label={`${t('gallery.goto')} ${i + 1}`}
              aria-current={i === 0 ? 'true' : 'false'}
              class="group/dot grid size-6 place-items-center"
            >
              <span class="block size-1.5 bg-mu/50 transition-colors group-hover/dot:bg-tx group-aria-[current=true]/dot:bg-accent"></span>
            </button>
          ))}
        </div>
      </div>
    </>
  )}
</div>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]');
    if (!track) return;
    const count = track.children.length;
    if (count < 2) return;

    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    let index = 0;

    const go = (target: number) => {
      index = (target + count) % count; // a végén körbefordul
      track.scrollTo({
        left: index * track.clientWidth,
        behavior: reduceMotion.matches ? 'auto' : 'smooth',
      });
    };

    const sync = () => {
      index = Math.round(track.scrollLeft / track.clientWidth);
      dots.forEach((dot, i) => dot.setAttribute('aria-current', String(i === index)));
    };

    root.querySelector('[data-dir="prev"]')?.addEventListener('click', () => go(index - 1));
    root.querySelector('[data-dir="next"]')?.addEventListener('click', () => go(index + 1));
    dots.forEach((dot, i) => dot.addEventListener('click', () => go(i)));

    // Húzás / görgetés / swipe után is frissüljön a jelölés
    let frame = 0;
    track.addEventListener(
      'scroll',
      () => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(sync);
      },
      { passive: true },
    );

    track.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        go(index - 1);
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        go(index + 1);
      }
    });
  });
</script>

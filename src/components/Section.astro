---
interface Props { id: string; label: string }
const { id, label } = Astro.props;
---

<section id={id} class="flex scroll-mt-6 flex-col gap-4">
  <h2 class="flex items-center gap-3 pb-2">
    <span class="block size-2 shrink-0 bg-accent" aria-hidden="true"></span>
    <span class="font-mono text-[0.95rem] font-medium tracking-[0.18em] text-tx uppercase">{label}</span>
    <span
      class="h-px flex-1 [background:repeating-linear-gradient(90deg,var(--color-line2)_0_5px,transparent_5px_10px)]"
      aria-hidden="true"
    ></span>
  </h2>
  <slot />
</section>
